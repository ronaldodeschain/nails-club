{
  "$schema": "https://schemas.wp.org/wp/6.7/theme.json",
  "version": 3,
  "settings": {
    "color": {
      "palette": [
        { "slug": "club-ink", "name": "Nails Club: fundo", "color": "#0a0a0a" },
        { "slug": "club-panel", "name": "Nails Club: painel", "color": "#1a1a1a" },
        { "slug": "club-paper", "name": "Nails Club: texto", "color": "#e0e0e0" },
        { "slug": "club-muted", "name": "Nails Club: texto secundário", "color": "#a0a0a0" },
        { "slug": "club-cyan", "name": "Nails Club: destaque", "color": "#00b3ff" },
        { "slug": "club-violet", "name": "Nails Club: acento", "color": "#9d4edd" }
      ]
    },
    "typography": {
      "fontFamilies": [
        { "fontFamily": "Georgia, serif", "slug": "club-serif", "name": "Nails Club: serif" },
        { "fontFamily": "Arial, sans-serif", "slug": "club-sans", "name": "Nails Club: sem serifa" }
      ]
    },
    "layout": {
      "contentSize": "68rem",
      "wideSize": "80rem"
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|club-ink",
      "text": "var:preset|color|club-paper"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|club-serif",
      "lineHeight": "1.6"
    },
    "elements": {
      "link": {
        "color": { "text": "var:preset|color|club-cyan" }
      }
    }
  }
}